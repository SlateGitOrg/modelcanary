# Environment variables read by `modelcanary` (all optional; CLI flags take precedence).
MODELCANARY_POLICY=configs/default.toml
MODELCANARY_MODELS_DIR=models
MODELCANARY_PRODUCTION=lr-v1
MODELCANARY_AUDIT_PATH=var/audit.jsonl
MODELCANARY_HOST=127.0.0.1
MODELCANARY_PORT=8000
MODELCANARY_LOG_LEVEL=WARNING
